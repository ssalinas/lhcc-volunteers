# Copy to .env and fill in real values. Never commit the real .env file.

NODE_ENV=production
PORT=3000
DATABASE_PATH=./data/lhcc.sqlite

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public URL the app is served at (matches your reverse proxy / Cloudflare Tunnel).
BETTER_AUTH_URL=https://volunteers.example.org
# Comma-separated list of origins allowed to call the API (usually just BETTER_AUTH_URL in prod).
TRUSTED_ORIGINS=https://volunteers.example.org

# From Google Cloud Console > APIs & Services > Credentials (OAuth client).
# Authorized redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# How far ahead recurring events are materialized into concrete occurrences.
OCCURRENCE_HORIZON_WEEKS=8
# Rolling lookback window used by the fairness-based auto-scheduler.
FAIRNESS_LOOKBACK_WEEKS=6

# Only used by `npm run db:seed` to create the first admin account.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Admin
